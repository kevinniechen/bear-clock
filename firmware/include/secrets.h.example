// Copy to secrets.h (gitignored) and fill in.
#pragma once

// Networks to join, tried in order of signal strength. ESP32 is 2.4 GHz only.
// iPhone hotspot: turn on "Maximize Compatibility". Watch out for the curly
// apostrophe in names like "Kevin’s iPhone" — copy it exactly or rename the phone.
#define WIFI_NETWORKS                 \
  {"Kevin’s iPhone", "hotspot-pass"}, \
  {"HomeWiFi", "home-pass"},

// Secret topic for admin commands (the admin page URL carries it after #).
#define NTFY_ADMIN_TOPIC "bearclock-admin-CHANGE-ME"
// PIN for the admin page when used over the board's own hotspot.
#define ADMIN_PIN "1234"
