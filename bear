#!/bin/sh
# One-word commands for build day.  ./bear <cmd>
#   sim       tests + render sim/demo.gif (no hardware needed)
#   flash     build + upload over USB + open serial monitor
#   ota IP    build + upload over Wi-Fi to the board at IP
#   monitor   serial monitor only
#   send MSG  post a guest message through ntfy
#   cmd JSON  post an admin command, e.g. ./bear cmd '{"cmd":"start"}'
#   archive   save wall photos to ~/Pictures/bear-wall (leave running)
set -e
cd "$(dirname "$0")"
topic() { sed -n "s/^#define $1 \"\(.*\)\"/\1/p" "$2"; }
case "$1" in
  sim) sim/run.sh && open sim/demo.gif 2>/dev/null || true ;;
  flash) cd firmware && pio run -t upload -t monitor ;;
  ota) [ -n "$2" ] || { echo "usage: ./bear ota <board-ip>"; exit 2; }
       PLATFORMIO_UPLOAD_FLAGS="--auth=$(topic ADMIN_PIN firmware/include/secrets.h)" \
         sh -c "cd firmware && pio run -e ota -t upload --upload-port '$2'" ;;
  monitor) cd firmware && pio device monitor ;;
  send) curl -fsS -d "$2" "https://ntfy.sh/$(topic NTFY_GUEST_TOPIC firmware/include/config.h)" >/dev/null && echo sent ;;
  cmd) curl -fsS -d "$2" "https://ntfy.sh/$(topic NTFY_ADMIN_TOPIC firmware/include/secrets.h)" >/dev/null && echo sent ;;
  archive) exec caffeinate -i python3 tools/archive_wall.py ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ; exit 2 ;;
esac
